VITE_MAPBOX_TOKEN=pk.your_token_here
# Optional: custom Mapbox Studio styles (overrides CT aerial overlays).
# Default basemaps:
#   Topo   = Mapbox Outdoors
#   Summer = CT ECO USDA NAIP 2023 leaf-on (~0.6 m)
#   Spring = CT ECO 2023 3″ ortho
#   mapbox://styles/<your-username>/<style-id>
# VITE_MAPBOX_STYLE_TERRAIN=mapbox://styles/your-user/your-terrain-style-id
# VITE_MAPBOX_STYLE_SATELLITE=mapbox://styles/your-user/your-summer-style-id
# VITE_MAPBOX_STYLE_AERIAL=mapbox://styles/your-user/your-spring-style-id
VITE_CF_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token
